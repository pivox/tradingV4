<?xml version="1.0"?>
<ruleset name="control-plane">
    <description>PSR-12 sur le control plane</description>
    <arg name="colors"/>
    <arg value="sp"/>
    <arg name="cache" value=".phpcs-cache"/>
    <file>src</file>
    <file>tests</file>
    <file>bin/console</file>
    <file>config</file>
    <exclude-pattern>tests/fixtures/*</exclude-pattern>
    <exclude-pattern>config/reference.php</exclude-pattern>
    <rule ref="PSR12"/>
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="140"/>
            <property name="absoluteLineLimit" value="0"/>
        </properties>
        <!-- Les tests portent des chaînes de messages et des motifs longs. -->
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
</ruleset>

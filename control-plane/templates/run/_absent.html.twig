{# Section sans données : titre, mention « absent au jalon 1 » et la raison. Rien n'est inventé ni estimé. #}
<section id="{{ id }}" class="section absent" aria-labelledby="{{ id }}-titre">
  <h2 id="{{ id }}-titre">{{ title }}</h2>
  <p class="absent-note"><strong>Absent au jalon 1.</strong> {{ reason }}</p>
</section>

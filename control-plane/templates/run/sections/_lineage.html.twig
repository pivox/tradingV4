<section id="lineage" class="section" aria-labelledby="lineage-titre">
  <h2 id="lineage-titre">Lineage</h2>
  <p class="note">Hashes affichés tels que tv4 les a écrits ; le control plane n'en recalcule aucun.</p>
  <table class="kv wide">
    <tr><th scope="row"><code>config_hash</code></th><td><code class="hash">{{ manifest.configHash }}</code></td></tr>
    <tr><th scope="row"><code>dataset_hash</code> ({{ manifest.hashFormat }})</th><td><code class="hash">{{ manifest.datasetHash }}</code></td></tr>
    <tr><th scope="row"><code>result_hash</code></th><td><code class="hash">{{ manifest.resultHash }}</code></td></tr>
    <tr><th scope="row"><code>run_id</code></th><td><code class="hash">{{ manifest.runId }}</code></td></tr>
    <tr><th scope="row">Version de la stratégie</th><td>{{ manifest.config.strategyId }} {{ manifest.config.strategyVersion }}</td></tr>
    <tr><th scope="row">Moteur : version</th><td>{{ manifest.engine.tv4Version }}</td></tr>
    <tr><th scope="row">Moteur : commit</th><td><code class="hash">{{ manifest.engine.gitSha }}</code></td></tr>
    <tr><th scope="row">Moteur : rustc</th><td>{{ manifest.engine.rustc }} (<code class="hash">{{ manifest.engine.rustcCommit }}</code>)</td></tr>
    <tr><th scope="row">Moteur : cible</th><td>{{ manifest.engine.target }}, cpu {{ manifest.engine.targetCpu }}, profil {{ manifest.engine.profile }}</td></tr>
    <tr><th scope="row">Moteur : <code>binary_hash</code></th><td><code class="hash">{{ manifest.engine.binaryHash }}</code></td></tr>
    <tr>
      <th scope="row">Données</th>
      <td>
        {% if metrics.dataBars is not null -%}
        {{ metrics.dataBars|int }} bougies · {{ metrics.minutesMissing|int }} minutes absentes ·
        warmup {{ manifest.config.warmupBars|int }} bougies ·
        {{ metrics.dataSyntheticBars|int }} synthétiques · trous : <code>{{ manifest.data.gapsPolicy }}</code>
        {%- else -%}
        {% for s in manifest.data.series %}<code>{{ s.symbol }}</code> : {{ s.rows|int }} lignes{% if s.firstMs is not null %} ({{ s.firstMs|datetime }} → {{ s.lastMs|datetime }}){% endif %}{% if not loop.last %} · {% endif %}{% else %}aucun segment déclaré{% endfor %} ·
        warmup {{ manifest.config.warmupBars|int }} bougies · trous : <code>{{ manifest.data.gapsPolicy }}</code>
        {%- endif %}

        {% if manifest.data.fixtureBlake3 is not null %}<br>Fixture <code>blake3</code> : <code class="hash">{{ manifest.data.fixtureBlake3 }}</code>{% endif %}
      </td>
    </tr>
{% if metrics.isPortfolio %}
    <tr><th scope="row">Capital initial (hors <code>config_hash</code>)</th><td>{{ manifest.config.initialCash|money }}</td></tr>
    <tr>
      <th scope="row">Univers</th>
      <td>{% for symbol in manifest.data.symbols %}<code>{{ symbol }}</code>{% if not loop.last %}, {% endif %}{% endfor %} (ordre de la config, départage du rang de priorité)</td>
    </tr>
    <tr>
      <th scope="row">Régime</th>
      <td>
        {% if metrics.regime is null -%}
          aucun : la stratégie ne lit pas le régime
        {%- else -%}
          <code>{{ metrics.regime.symbol }}</code> {{ metrics.regime.tf }}, SMA {{ metrics.regime.smaPeriod|int }}
          · premier jour prêt : {{ metrics.regime.firstReadyMs|datetime }}
          · {{ metrics.regime.daysBull|int }} jours haussiers, {{ metrics.regime.daysBear|int }} baissiers sur la fenêtre
        {%- endif %}
      </td>
    </tr>
    <tr>
      <th scope="row">Instruments</th>
      <td>
        {% if metrics.instruments is null -%}
          non déclarés. Ce run ne porte pas de bloc <code>instruments</code>
        {%- else -%}
          source <code>{{ metrics.instruments.source }}</code>
          {% set instrumentsFile = metrics.instruments.file ?? manifest.instrumentsFile %}
          {%- if instrumentsFile is not null %} · fichier <code>{{ instrumentsFile }}</code>{% endif %}
          {%- if metrics.instruments.fetchedAt is not null %} · relevé le {{ metrics.instruments.fetchedAt }}{% endif %}
          {%- if metrics.instruments.instrumentsHash is not null %}<br><code>instruments_hash</code> : <code class="hash">{{ metrics.instruments.instrumentsHash }}</code>{% endif %}
          {%- if metrics.instruments.notLive is not empty %}<br>Hors état <code>live</code> : {% for symbol in metrics.instruments.notLive %}<code>{{ symbol }}</code>{% if not loop.last %}, {% endif %}{% endfor %}{% endif %}
          <br>Changements à venir annoncés par OKX (non appliqués au backtest) :
          {% for change in metrics.instruments.upcomingChanges -%}
            {% if loop.first %}<ul>{% endif %}<li><code>{{ change.instId }}</code> : <code>{{ change.param }}</code> devient <code>{{ change.newValue }}</code>, effectif {% if change.effTimeMs is not null %}{{ change.effTimeMs|datetime }}{% else %}<code>{{ change.effTime }}</code>{% endif %}</li>{% if loop.last %}</ul>{% endif %}
          {%- else -%}
            aucun
          {%- endfor %}
        {%- endif %}
      </td>
    </tr>
{% if metrics.isCosts %}    <tr><th scope="row">Profil de coûts</th><td><code>{{ metrics.costs.profile }}</code> ({{ metrics.costs.gatesProfile ? 'profil de porte' : 'profil informatif, hors portes' }}) · graine {{ metrics.costs.seed|int }} · grille <code>{{ metrics.costs.feeGrid }}</code> · modèle de coûts <code>{{ metrics.costs.rulesVersion }}</code></td></tr>
    <tr><th scope="row"><code>costs_file_hash</code></th><td><code>{{ metrics.costs.costsFile }}</code> : <code class="hash">{{ metrics.costs.costsFileHash }}</code></td></tr>
    {% if metrics.costs.costMeasuresHash is not null %}<tr><th scope="row"><code>cost_measures_hash</code></th><td>{% if metrics.costs.costMeasuresFile is not null %}<code>{{ metrics.costs.costMeasuresFile }}</code> : {% endif %}<code class="hash">{{ metrics.costs.costMeasuresHash }}</code></td></tr>
    {% endif %}{% if manifest.profilesId is not null %}<tr><th scope="row"><code>profiles_id</code></th><td><code class="hash">{{ manifest.profilesId }}</code></td></tr>
{% endif %}{% endif %}{% endif %}{% if metrics.isResearch %}
    <tr><th scope="row">Bloc de recherche</th><td><code>{{ metrics.research.block }}</code> · ligne <code>{{ metrics.research.line }}</code> · fenêtre de décision {{ metrics.research.decisionWindow.startMs|datetime }} → {{ metrics.research.decisionWindow.endMs|datetime }}</td></tr>
    <tr><th scope="row">Identité de recherche (<code>research.identity_hash</code>)</th><td><code class="hash">{{ metrics.research.identityHash }}</code> (hors <code>config_hash</code>, docs/specs/s11.md §8.6)</td></tr>{% endif %}
  </table>
  <p class="absent-note"><strong>Absent au jalon 1.</strong> <code>version_hash</code> : le jalon 1 identifie la version du code par la version de la stratégie. Reproductibilité (« rejoué le …, identique à l'octet ») et bouton « Rejouer » : aucun <code>tv4 verify</code> n'est enregistré dans le run, jalon 2.</p>
</section>
